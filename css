* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    background: #f5f7fb;
    color: #222;
}

/* Navigation */

header {
    background: #111827;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar {
    max-width: 1100px;
    margin: auto;
    padding: 18px 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
}

.nav-links {
    list-style: none;
    display: flex;
    gap: 20px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.nav-links a:hover {
    color: #60a5fa;
}

/* Home */

.hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #dbeafe, #f8fafc);
}

.hero-content {
    width: 1100px;
    max-width: 90%;
    margin: auto;

    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
}

.welcome {
    color: #2563eb;
    font-weight: bold;
    margin-bottom: 10px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 10px;
}

.hero h1 span {
    color: #2563eb;
}

.hero h2 {
    margin-bottom: 15px;
}

.hero p {
    max-width: 550px;
    margin-bottom: 20px;
}

/* Button */

button {
    background: #2563eb;
    color: white;
    border: none;
    padding: 12px 22px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background: #1d4ed8;
}

/* Profile */

.profile-container img {
    width: 260px;
    height: 260px;
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid white;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
}

/* Sections */

.section {
    max-width: 1100px;
    margin: auto;
    padding: 80px 20px;
}

.section > h2 {
    text-align: center;
    font-size: 32px;
    margin-bottom: 35px;
    color: #1e3a8a;
}

/* About */

.about-box {
    background: white;
    padding: 30px;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.about-box h3 {
    margin-top: 15px;
    color: #2563eb;
}

/* Skills */

.skills-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.skill-card h3 {
    color: #2563eb;
    margin-bottom: 15px;
}

.skill-card ul {
    padding-left: 20px;
}

/* Projects */

.projects-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.project-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.project-card h3 {
    color: #2563eb;
    margin-bottom: 10px;
}

.project-card a {
    color: #2563eb;
    text-decoration: none;
    font-weight: bold;
}

/* Certifications */

.certificate-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.certificate-card {
    background: white;
    padding: 25px;
    border-left: 5px solid #2563eb;
    border-radius: 8px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.certificate-card h3 {
    color: #2563eb;
}

/* Contact */

.contact-box {
    background: white;
    max-width: 700px;
    margin: auto;
    padding: 30px;
    text-align: center;
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.08);
}

.contact-box p {
    margin: 15px;
}

.contact-box a {
    color: #2563eb;
    text-decoration: none;
}

#message {
    color: #16a34a;
    font-weight: bold;
}

/* Footer */

footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 20px;
}

